{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "inventory-system",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-08-31",
  "build": {
    "command": "npm run build"
  },
  // Sync persistence (Live Sync): create the namespace once in Cloudflare dashboard
  // (Workers & Pages -> KV -> Create namespace: INVENTORY_KV), then paste the ID below.
  // Until bound, the Worker seamlessly uses the isolate in-memory fallback.
  // "kv_namespaces": [
  //   {
  //     "binding": "INVENTORY_KV",
  //     "id": "PASTE_INVENTORY_KV_ID_HERE"
  //   }
  // ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    }
  }
}
