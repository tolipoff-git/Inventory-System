{
  "name": "inventory-system",
  "private": true,
  "version": "128.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src vite.config.ts tests",
    "check:i18n": "node scripts/check-i18n-parity.mjs",
    "deploy": "npm run build && npx wrangler deploy",
    "deploy:prod": "npm run build && npx wrangler deploy --env production",
    "test:labels-browser": "node scripts/check-label-print.mjs",
    "test:pwa-browser": "node scripts/check-pwa-offline.mjs"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "jspdf": "^4.2.1",
    "jsqr": "^1.4.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/qrcode": "^1.5.5",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "eslint": "^10.10.0",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.14.6",
    "playwright": "^1.64.0",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^6.0.1",
    "vitest": "^5.0.0",
    "wrangler": "^4.130.0"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
